# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://gatestock.example

# --- Socials (hidden from the nav and the footer while unset) -----------
NEXT_PUBLIC_GATESTOCK_X=

# --- Legal (/privacy and /terms) ----------------------------------------
# Anything left unset renders as a visible dashed placeholder on those pages,
# so the site cannot go live with invented facts in it.
NEXT_PUBLIC_GATESTOCK_ENTITY=
NEXT_PUBLIC_GATESTOCK_JURISDICTION=
NEXT_PUBLIC_GATESTOCK_CONTACT=
NEXT_PUBLIC_GATESTOCK_HOST=
NEXT_PUBLIC_GATESTOCK_LEGAL_UPDATED=
